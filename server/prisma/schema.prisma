generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  PARTICIPANT
  COORDINATOR
  CURATOR
  ADMIN
}

enum RoleRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ArtworkCategory {
  DIGITAL
  TRADITIONAL
  GRAPHIC
  AI
  FANART
  THREE_D
  PIXEL
}

enum ArtworkStatus {
  PENDING
  APPROVED
  REJECTED
  HIDDEN
}

enum ContestStatus {
  DRAFT
  OPEN
  CLOSED
  FINISHED
}

enum SubmissionStatus {
  SUBMITTED
  WITHDRAWN
}

model User {
  id          String   @id @default(uuid())
  firebaseUid String   @unique
  email       String   @unique
  username    String   @db.VarChar(30)
  avatarUrl   String?
  bio         String?
  role        Role     @default(PARTICIPANT)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  coordinatedContests Contest[]
  submissions         Submission[]
  scores              Score[]
  badges              UserBadge[]
  curatorAssignments  CuratorAssignment[]
  roleRequests        RoleRequest[]
  reviewedRequests    RoleRequest[]       @relation("RoleRequestReviewer")
  artworks            Artwork[]           @relation("ArtworkCreator")
  reviewedArtworks    Artwork[]           @relation("ArtworkReviewer")
}


model Artwork {
  id          String          @id @default(uuid())
  title       String          @db.VarChar(100)
  description String?         @db.VarChar(2000)
  imageUrl    String
  category    ArtworkCategory

  status           ArtworkStatus @default(PENDING)
  isPublic         Boolean       @default(true)
  moderationReason String?       @db.VarChar(1000)
  reviewedAt       DateTime?
  reviewedById     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  creatorId String
  creator   User   @relation("ArtworkCreator", fields: [creatorId], references: [id], onDelete: Cascade)

  reviewer User? @relation("ArtworkReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([status, isPublic, createdAt])
  @@index([creatorId])
  @@index([reviewedById])
}

model Contest {
  id          String        @id @default(uuid())
  title       String
  description String
  rules       String
  status      ContestStatus @default(DRAFT)
  startDate   DateTime
  endDate     DateTime
  createdAt   DateTime      @default(now())

  coordinatorId String
  coordinator   User @relation(fields: [coordinatorId], references: [id])

  submissions Submission[]
  criteria    Criteria[]
  curators    CuratorAssignment[]
  rewards     Reward[]
}

model Submission {
  id          String           @id @default(uuid())
  title       String
  description String
  imageUrl    String
  status      SubmissionStatus @default(SUBMITTED)
  createdAt   DateTime         @default(now())

  contestId String
  contest   Contest @relation(fields: [contestId], references: [id])

  participantId String
  participant   User   @relation(fields: [participantId], references: [id])

  scores Score[]
}

model Criteria {
  id          String @id @default(uuid())
  name        String
  description String
  weight      Float

  contestId String
  contest   Contest @relation(fields: [contestId], references: [id])

  scores Score[]
}

model CuratorAssignment {
  id String @id @default(uuid())

  curatorId String
  curator   User   @relation(fields: [curatorId], references: [id])

  contestId String
  contest   Contest @relation(fields: [contestId], references: [id])
}

model Score {
  id      String  @id @default(uuid())
  score   Float
  comment String?

  submissionId String
  submission   Submission @relation(fields: [submissionId], references: [id])

  curatorId String
  curator   User   @relation(fields: [curatorId], references: [id])

  criteriaId String
  criteria   Criteria @relation(fields: [criteriaId], references: [id])
}

model Badge {
  id          String  @id @default(uuid())
  name        String
  description String
  iconUrl     String?

  users UserBadge[]
}

model UserBadge {
  id String @id @default(uuid())

  userId String
  user   User   @relation(fields: [userId], references: [id])

  badgeId String
  badge   Badge  @relation(fields: [badgeId], references: [id])

  earnedAt DateTime @default(now())
}

model Reward {
  id          String @id @default(uuid())
  title       String
  description String
  placement   Int

  contestId String
  contest   Contest @relation(fields: [contestId], references: [id])
}

model RoleRequest {
  id String @id @default(uuid())

  userId String
  user   User   @relation(fields: [userId], references: [id])

  requestedRole Role

  status RoleRequestStatus @default(PENDING)

  reason String?

  reviewedById String?
  reviewedBy   User?   @relation("RoleRequestReviewer", fields: [reviewedById], references: [id])

  rejectionReason String?

  createdAt  DateTime  @default(now())
  reviewedAt DateTime?
}
